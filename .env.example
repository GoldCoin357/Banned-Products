# ============================================================
# Banned Products Detection System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ----- Application -----
APP_NAME="Banned Products Detection System"
APP_VERSION="1.0.0"
DEBUG=false

# ----- Database -----
# SQLite (default — no server needed)
DATABASE_URL=sqlite:///./banned_products.db

# PostgreSQL (production alternative)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/banned_products

# ----- Anthropic / Claude API -----
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ----- CPSC eSAFE Rapid API -----
# Obtain from CPSC: https://esafe.cpsc.gov
CPSC_RAPID_API_KEY=
CPSC_RAPID_SUBMIT_URL=https://esafe.cpsc.gov/Ess/Reporting/api

# CPSC eSAFE reporter information (shown in submitted reports)
ESAFE_REPORTER_NAME="Automated Detection System"
ESAFE_REPORTER_EMAIL=admin@example.com
ESAFE_REPORTER_PHONE=
ESAFE_REPORTER_ORG="CPSC Recall Monitoring Bot"

# ----- eBay API (optional — improves eBay results quality) -----
# Register at https://developer.ebay.com
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=
EBAY_SANDBOX=false

# ----- Scraping settings -----
SCRAPE_DELAY_MIN=1.0
SCRAPE_DELAY_MAX=3.0
MAX_CONCURRENT_SCRAPERS=3
REQUEST_TIMEOUT=30

# ----- Scheduler -----
SCRAPE_INTERVAL_MINUTES=60
CPSC_REFRESH_INTERVAL_HOURS=6

# ----- AI Detection -----
AI_CONFIDENCE_THRESHOLD=0.75
IMAGE_ANALYSIS_ENABLED=true
